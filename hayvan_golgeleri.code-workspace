{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "autopep8",
        "files.encoding": "utf8",
        "files.autoSave": "afterDelay",
        "editor.formatOnSave": false,
        "python.terminal.activateEnvironment": true,
        "[python]": {
            "editor.tabSize": 4,
            "editor.insertSpaces": true
        }
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Python: Hayvan Golgeleri",
                "type": "python",
                "request": "launch",
                "program": "${workspaceFolder}/hayvan_golgeleri.py",
                "console": "integratedTerminal",
                "justMyCode": true
            },
            {
                "name": "Python: Test Mode",
                "type": "python",
                "request": "launch",
                "program": "${workspaceFolder}/hayvan_golgeleri.py",
                "args": ["--test"],
                "console": "integratedTerminal",
                "justMyCode": true
            },
            {
                "name": "Python: Run Tests",
                "type": "python",
                "request": "launch",
                "program": "${workspaceFolder}/test_hayvan_golgeleri.py",
                "console": "integratedTerminal",
                "justMyCode": true
            }
        ]
    }
}
